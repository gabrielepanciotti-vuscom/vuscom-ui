{
  "name": "@vuscom/ui",
  "version": "1.19.0",
  "description": "Design system VUS COM: token, componenti e struttura delle pagine",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utenti": {
      "import": "./dist/utenti.js",
      "default": "./dist/utenti.js"
    },
    "./segnalazioni": {
      "import": "./dist/segnalazioni.js",
      "default": "./dist/segnalazioni.js"
    },
    "./grafici": {
      "import": "./dist/grafici.js",
      "default": "./dist/grafici.js"
    },
    "./preset": {
      "require": "./dist/preset.cjs",
      "default": "./dist/preset.cjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "catalogo": "vite catalogo",
    "notifica": "node scripts/rilascia-e-notifica.mjs",
    "deriva": "node scripts/controlla-deriva.mjs"
  },
  "peerDependencies": {
    "chart.js": "^4.4.1",
    "lucide-react": ">=0.290.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "chart.js": "^4.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.64.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "modern-screenshot": "4.7.0",
    "rrweb": "2.2.0",
    "tailwind-merge": "^2.6.1"
  },
  "bin": {
    "vuscom-ui-conformita": "./bin/conformita.mjs"
  }
